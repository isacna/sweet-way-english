# .env de produção (docker-compose.prod.yml). Na VPS: copie para /opt/sweetway/.env, preencha e `chmod 600 .env`.
# Gere segredos com: openssl rand -hex 32

# --- Endereço público ---
# Onde o Caddy atende. Com um domínio, o HTTPS é automático (o DNS do domínio precisa apontar para a VPS antes).
# Sem domínio, para testar: SITE_ENDERECO=http://localhost  e  URL_PUBLICA=http://localhost
SITE_ENDERECO=sweetwayenglish.com.br
URL_PUBLICA=https://sweetwayenglish.com.br

# --- Imagens (publicadas pelo CD no GitHub Container Registry) ---
GHCR_DONO=isacna
# latest = última versão da main; ou o sha de um commit para fixar/voltar uma versão
IMAGEM_TAG=latest

# --- Banco ---
POSTGRES_DB=sweetway
POSTGRES_USER=sweetway
# Obrigatório. Só letras e números (ou use URL encoding em DATABASE_URL)
POSTGRES_PASSWORD=

# --- API ---
# Obrigatório, mínimo 16 caracteres
JWT_SECRET=
JWT_EXPIRES_IN=7d
LOG_LEVEL=info
UPLOAD_MAX_MB=10

# --- E-mail (Resend) ---
# Sem domínio verificado no Resend, o remetente onboarding@resend.dev só entrega no e-mail da própria conta Resend.
RESEND_API_KEY=
EMAIL_FROM=Sweet Way English <onboarding@resend.dev>

# --- Primeira subida ---
# SEED_ON_START=1 na primeira vez (cria o admin e importa o curso em revisão); depois volte para 0.
SEED_ON_START=0
ADMIN_EMAIL=
# Mínimo 10 caracteres; troque pelo site depois do primeiro login
ADMIN_SENHA=
ADMIN_NOME=
# Nunca em produção: contas de demonstração com senha123
SEED_DEMO=
SEED_PUBLICAR_CONTEUDO=

# --- Backup ---
TZ=America/Sao_Paulo
# Formato cron (minuto hora dia mês dia-da-semana), no fuso TZ
BACKUP_HORARIO=30 3 * * *
BACKUP_RETENCAO_DIAS=30
# Senha de criptografia dos backups (gpg). GUARDE FORA DA VPS: sem ela o backup não abre.
BACKUP_SENHA=
# Cópia fora da VPS com rclone (remoto configurado em deploy/rclone/rclone.conf), ex.: r2:sweetway-backups
BACKUP_RCLONE_DESTINO=
# healthchecks.io: avisa se o backup falhar ou não rodar (ex.: https://hc-ping.com/<uuid>)
BACKUP_PING_URL=
