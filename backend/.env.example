# Obrigatório, mínimo 16 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Validade do login (formato do jsonwebtoken: 7d, 12h...)
JWT_EXPIRES_IN=7d

APP_URL=http://localhost:3333
PORT=3333
# Origens do frontend permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000
# Tamanho máximo de upload em MB
UPLOAD_MAX_MB=10

# development | test | production
NODE_ENV=development
# Quantos proxies reversos ficam na frente da API (Caddy/Nginx = 1). 0 em dev.
TRUST_PROXY=0

# Seed (npm run db:seed)
# Conta admin inicial; só é criada se ainda não existir (a senha de uma conta existente não muda). Mínimo 10 caracteres.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=
# Dados de demonstração (contas com senha "senha123"): ligados em dev, desligados em produção.
# SEED_DEMO=1 força ligar; SEED_DEMO=0 desliga também em dev.
SEED_DEMO=

DATABASE_URL=file:./prisma/dev.db
