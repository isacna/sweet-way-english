# Obrigatório, mínimo 16 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Validade do login (formato do jsonwebtoken: 7d, 12h...)
JWT_EXPIRES_IN=7d

APP_URL=http://localhost:3333
PORT=3333
# Origens do frontend permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000
# Tamanho máximo de upload em MB
UPLOAD_MAX_MB=10

# development | test | production
NODE_ENV=development
# Quantos proxies reversos ficam na frente da API (Caddy/Nginx = 1). 0 em dev.
TRUST_PROXY=0

# Seed (npm run db:seed)
# Conta admin inicial; só é criada se ainda não existir (a senha de uma conta existente não muda). Mínimo 10 caracteres.
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_NOME=
# Dados de demonstração (contas com senha "senha123"): ligados em dev, desligados em produção.
# SEED_DEMO=1 força ligar; SEED_DEMO=0 desliga também em dev.
SEED_DEMO=

# PostgreSQL 17. Um banco local descartável para desenvolvimento:
#   docker run -d --name sweetway-pg -p 5432:5432 -e POSTGRES_USER=sweetway \
#     -e POSTGRES_PASSWORD=sweetway -e POSTGRES_DB=sweetway postgres:17-alpine
# (POSTGRES_* abaixo são só referência; o docker compose lê os do .env da raiz.)
POSTGRES_DB=sweetway
POSTGRES_USER=sweetway
POSTGRES_PASSWORD=sweetway
DATABASE_URL=postgresql://sweetway:sweetway@localhost:5432/sweetway

# Opcional: banco descartável para npm run test:db (é APAGADO a cada execução; o nome precisa conter "test")
# TEST_DATABASE_URL=postgresql://sweetway:sweetway@localhost:5432/sweetway_test

# Opcional: arquivo SQLite antigo para npm run db:migrar-sqlite
# SQLITE_PATH=./prisma/dev.db
