{
  // Build de produção: compila src/ para dist/ (npm run build; o servidor roda com node dist/server.js).
  // O client do Prisma (src/database/generated, JS já pronto) é copiado para dist/ por scripts/copiar-prisma-client.mjs.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "allowJs": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__", "src/database/generated"]
}
