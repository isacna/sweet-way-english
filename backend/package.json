{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "npm run clean && prisma generate && tsc -p tsconfig.build.json && node scripts/copiar-prisma-client.mjs",
    "start": "node dist/server.js",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "db:seed": "prisma db seed",
    "db:migrar-sqlite": "tsx scripts/migrar-sqlite-para-postgres.ts",
    "conteudo:validar": "tsx scripts/validar-conteudo.ts",
    "conteudo:importar": "tsx scripts/importar-conteudo.ts",
    "lembretes:enviar": "tsx scripts/enviar-lembretes.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.3",
    "file-type": "^21.3.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "better-sqlite3": "^12.11.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.2.2",
    "typescript": "~5.8.2",
    "vitest": "^4.1.12"
  }
}
