generator client {
  provider = "prisma-client-js"
  output   = "../src/database/generated/prisma"
}

// PostgreSQL (desde a F1 de docs/plano-producao.md). A URL vem de DATABASE_URL (prisma.config.ts).
// As migrações antigas do SQLite estão arquivadas em prisma/migrations-sqlite-arquivo/.
datasource db {
  provider = "postgresql"
}

// Convenções:
//  - `criadoEm` + `atualizadoEm` nos modelos editáveis;
//  - toda chave estrangeira tem índice (Postgres não cria sozinho) e `onDelete` explícito;
//  - os valores dos enums são os mesmos strings da API (o contrato e o frontend não mudam).

enum Papel {
  aluno
  professor
}

// Professores e alunos na mesma tabela. `admin` é um privilégio à parte do papel
// (o dono da plataforma pode ser admin e estudar como aluno).
model Usuario {
  id                         Int              @id @default(autoincrement())
  nome                       String
  // Sempre minúsculo (normalizado na aplicação), por isso o índice único já não diferencia maiúsculas.
  email                      String           @unique
  senha                      String
  papel                      Papel
  admin                      Boolean          @default(false)
  // LGPD art. 14: menores de 18 precisam de consentimento do responsável
  dataNascimento             DateTime?
  responsavelNome            String?
  responsavelEmail           String?
  consentimentoResponsavelEm DateTime?
  // Entra no JWT como `v`; incrementar derruba todas as sessões abertas (troca/redefinição de senha)
  versaoToken                Int              @default(0)
  criadoEm                   DateTime         @default(now())
  atualizadoEm               DateTime         @updatedAt
  turmas                     Turma[]
  feedbacks                  Feedback[]
  matriculas                 Matricula[]
  submissoes                 Submissao[]
  perfilAprendiz             PerfilAprendiz?
  progressosLicao            ProgressoLicao[]
  revisoes                   RevisaoItem[]
  tentativasTeste            TentativaTeste[]
  notasLicao                 NotaLicao[]
  licoesRevisadas            Licao[]          @relation("LicaoRevisor")
  tokensSenha                TokenSenha[]
  arquivos                   Arquivo[]
  certificados               Certificado[]
}

// Pedido de redefinição de senha. Guarda só o SHA-256 do token enviado por e-mail, nunca o token.
model TokenSenha {
  id        Int       @id @default(autoincrement())
  usuarioId Int
  hashToken String    @unique
  expiraEm  DateTime
  usadoEm   DateTime?
  criadoEm  DateTime  @default(now())
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

model Turma {
  id            Int             @id @default(autoincrement())
  nome          String
  descricao     String?
  codigoConvite String          @unique
  professorId   Int
  criadoEm      DateTime        @default(now())
  atualizadoEm  DateTime        @updatedAt
  // Restrict: apagar uma professora exige decidir antes o destino das turmas (ConfigController faz isso)
  professor     Usuario         @relation(fields: [professorId], references: [id], onDelete: Restrict)
  matriculas    Matricula[]
  atividades    Atividade[]
  materiais     MaterialApoio[]
  avisos        Aviso[]

  @@index([professorId])
}

model Aviso {
  id       Int      @id @default(autoincrement())
  titulo   String
  conteudo String?
  link     String?
  turmaId  Int
  criadoEm DateTime @default(now())
  turma    Turma    @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@index([turmaId])
}

enum StatusMatricula {
  ativa
  inativa
}

model Matricula {
  id            Int             @id @default(autoincrement())
  alunoId       Int
  turmaId       Int
  dataMatricula DateTime        @default(now())
  status        StatusMatricula @default(ativa)
  aluno         Usuario         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  turma         Turma           @relation(fields: [turmaId], references: [id], onDelete: Cascade)

  @@unique([alunoId, turmaId])
  @@index([turmaId])
}

model Atividade {
  id                 Int         @id @default(autoincrement())
  titulo             String
  descricao          String
  dataEntrega        DateTime
  arquivoObrigatorio Boolean     @default(false)
  link               String?
  // Anexo opcional da professora (enunciado, worksheet…)
  arquivoId          String?     @unique
  turmaId            Int
  criadoEm           DateTime    @default(now())
  atualizadoEm       DateTime    @updatedAt
  turma              Turma       @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  arquivo            Arquivo?    @relation(fields: [arquivoId], references: [id], onDelete: Restrict)
  submissoes         Submissao[]

  @@index([turmaId])
}

enum StatusSubmissao {
  pendente
  aprovado
  reprovado
  corrigido
}

model Submissao {
  id           Int             @id @default(autoincrement())
  atividadeId  Int
  alunoId      Int
  conteudo     String?
  arquivoId    String?         @unique
  dataEnvio    DateTime        @default(now())
  status       StatusSubmissao @default(pendente)
  atualizadoEm DateTime        @updatedAt
  atividade    Atividade       @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  aluno        Usuario         @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  arquivo      Arquivo?        @relation(fields: [arquivoId], references: [id], onDelete: Restrict)
  feedback     Feedback?

  @@index([atividadeId])
  @@index([alunoId])
}

model Feedback {
  id           Int       @id @default(autoincrement())
  submissaoId  Int       @unique
  professorId  Int
  comentario   String
  nota         Float
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  submissao    Submissao @relation(fields: [submissaoId], references: [id], onDelete: Cascade)
  // Restrict: notas dadas não somem junto com a conta da professora sem uma decisão explícita
  professor    Usuario   @relation(fields: [professorId], references: [id], onDelete: Restrict)

  @@index([professorId])
}

model ConfiguracaoApp {
  id           Int      @id @default(1)
  // Logo da escola: nome do arquivo dentro de UPLOAD_DIR. É público (GET /api/configuracoes/logo), por isso
  // fica fora do modelo Arquivo, que é sempre privado.
  logoCaminho  String?
  atualizadoEm DateTime @updatedAt
}

enum TipoMaterial {
  pdf
  audio
  video
  link
}

model MaterialApoio {
  id        Int          @id @default(autoincrement())
  titulo    String
  tipo      TipoMaterial
  // Exatamente um dos dois (CHECK no banco): `url` para links externos, `arquivoId` para upload
  url       String?
  arquivoId String?      @unique
  turmaId   Int
  criadoEm  DateTime     @default(now())
  turma     Turma        @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  arquivo   Arquivo?     @relation(fields: [arquivoId], references: [id], onDelete: Restrict)

  @@index([turmaId])
}

// Metadados de um upload privado. O arquivo fica em UPLOAD_DIR/<caminho> (nome aleatório, nunca vindo do
// usuário) e só é servido por GET /api/arquivos/:id, que confere quem pode ver.
// Cada arquivo pertence a no máximo um registro (Atividade, Submissao ou MaterialApoio: arquivoId @unique).
// onDelete Restrict nos dois sentidos: o banco não apaga a linha sozinho, porque o arquivo no disco também
// precisa sair (src/storage/arquivos.ts, apagarArquivos). Quem apaga usuário ou turma remove os arquivos antes.
model Arquivo {
  id           String         @id @default(uuid())
  donoId       Int
  nomeOriginal String
  caminho      String
  mime         String
  tamanho      Int
  criadoEm     DateTime       @default(now())
  dono         Usuario        @relation(fields: [donoId], references: [id], onDelete: Restrict)
  atividade    Atividade?
  submissao    Submissao?
  material     MaterialApoio?

  @@index([donoId])
}

// ─── Curso autoguiado (A1 → B1) ──────────────────────────────────────────────
// Conteúdo-fonte em prisma/conteudo/<nivel>/*.json (formato em src/domain/conteudo/schema.ts).
// Nada aparece para o aluno sem status `publicado` (aprovação da professora).

enum StatusConteudo {
  rascunho
  revisao
  publicado
}

// Etapas do fluxo PPP: controlada → semicontrolada → producao → quiz (ETAPAS em schema.ts)
enum EtapaExercicio {
  controlada
  semicontrolada
  producao
  quiz
}

// Tipos de item (discriminador `tipo` em schema.ts); vale para Exercicio e ItemTeste
enum TipoExercicio {
  sequence
  dictation
  mcq
  cloze
  word_order
  match
  translate
  error_correction
}

// HABILIDADES_TESTE em schema.ts
enum HabilidadeTeste {
  gramatica_vocabulario
  leitura
  escrita
}

// Só "gramatica" está disponível na v1
enum Metodologia {
  gramatica
  comunicativa
  gamificada
  input
}

model Nivel {
  id           Int           @id @default(autoincrement())
  codigo       String        @unique // "A1"
  nome         String
  descricao    String?
  ordem        Int
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt
  modulos      Modulo[]
  certificados Certificado[]
}

model Modulo {
  id              Int              @id @default(autoincrement())
  nivelId         Int
  ordem           Int
  slug            String           @unique // "a1-m01"
  titulo          String
  tema            String
  descricao       String
  canDos          Json // string[]
  gramatica       String
  vocabulario     String
  funcao          String
  pronuncia       String?
  status          StatusConteudo   @default(revisao)
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt
  nivel           Nivel            @relation(fields: [nivelId], references: [id], onDelete: Restrict)
  licoes          Licao[]
  itensTeste      ItemTeste[]
  tentativasTeste TentativaTeste[]

  // o índice composto também cobre buscas por nivelId
  @@unique([nivelId, ordem])
}

model Licao {
  id               Int              @id @default(autoincrement())
  moduloId         Int
  ordem            Int
  slug             String           @unique // "a1-m01-l1"
  titulo           String
  objetivo         String
  minutosEstimados Int
  apresentacao     Json // Apresentacao (schema.ts)
  status           StatusConteudo   @default(revisao)
  revisadoPorId    Int?
  revisadoEm       DateTime?
  criadoEm         DateTime         @default(now())
  atualizadoEm     DateTime         @updatedAt
  modulo           Modulo           @relation(fields: [moduloId], references: [id], onDelete: Cascade)
  revisadoPor      Usuario?         @relation("LicaoRevisor", fields: [revisadoPorId], references: [id], onDelete: SetNull)
  exercicios       Exercicio[]
  progressos       ProgressoLicao[]
  notas            NotaLicao[]

  @@unique([moduloId, ordem])
  @@index([revisadoPorId])
}

model Exercicio {
  id           Int            @id @default(autoincrement())
  licaoId      Int
  ordem        Int
  etapa        EtapaExercicio
  tipo         TipoExercicio
  enunciado    String
  conteudo     Json // parte pública (vai para o navegador)
  gabarito     Json // NUNCA vai para o navegador do aluno
  explicacao   String // feedback em PT mostrado após responder
  tagsErro     Json? // string[] — erros típicos de brasileiros (ex.: "terceira_pessoa_s")
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  licao        Licao          @relation(fields: [licaoId], references: [id], onDelete: Cascade)
  revisoes     RevisaoItem[]

  @@index([licaoId])
}

model ItemTeste {
  id         Int             @id @default(autoincrement())
  moduloId   Int
  forma      Int // formas paralelas: 1, 2…
  ordem      Int
  habilidade HabilidadeTeste
  tipo       TipoExercicio
  enunciado  String
  conteudo   Json
  gabarito   Json
  explicacao String
  criadoEm   DateTime        @default(now())
  modulo     Modulo          @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@index([moduloId])
}

// ─── Estado do aprendiz ─────────────────────────────────────────────────────

model PerfilAprendiz {
  id               Int         @id @default(autoincrement())
  usuarioId        Int         @unique
  metodologia      Metodologia @default(gramatica)
  xp               Int         @default(0)
  ofensivaAtual    Int         @default(0)
  ofensivaMaxima   Int         @default(0)
  ultimoEstudoEm   DateTime?
  /// Meta de XP por dia (10, 30 ou 60; ver METAS_DIARIAS em domain/progresso.ts)
  metaDiariaXp     Int         @default(30)
  /// XP ganho no dia de `ultimoEstudoEm` (fuso de Brasília); vale 0 se esse dia não é hoje
  xpDoDia          Int         @default(0)
  /// Quando terminou (ou pulou) as boas-vindas; null = ainda mostrar
  onboardingEm     DateTime?
  /// Aceitou receber lembretes de estudo por e-mail (opt-in)
  lembretesEmail   Boolean     @default(false)
  /// Último lembrete de estudo enviado (no máximo um por dia)
  ultimoLembreteEm DateTime?
  criadoEm         DateTime    @default(now())
  atualizadoEm     DateTime    @updatedAt
  usuario          Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

/// Certificado de conclusão de um nível (todos os testes de módulo do nível aprovados).
/// `codigo` é público: serve para qualquer pessoa conferir o certificado.
model Certificado {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  usuarioId Int
  nivelId   Int
  /// Nome do aluno no momento da emissão
  nomeAluno String
  emitidoEm DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  nivel     Nivel    @relation(fields: [nivelId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, nivelId])
  @@index([nivelId])
}

model ProgressoLicao {
  id               Int       @id @default(autoincrement())
  usuarioId        Int
  licaoId          Int
  concluida        Boolean   @default(false)
  melhorPercentual Int       @default(0)
  tentativas       Int       @default(0)
  concluidaEm      DateTime?
  criadoEm         DateTime  @default(now())
  atualizadoEm     DateTime  @updatedAt
  usuario          Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  licao            Licao     @relation(fields: [licaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, licaoId])
  @@index([licaoId])
}

// Anotações livres do aluno em cada lição (só ele vê)
model NotaLicao {
  id           Int      @id @default(autoincrement())
  usuarioId    Int
  licaoId      Int
  texto        String
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  licao        Licao    @relation(fields: [licaoId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, licaoId])
  @@index([licaoId])
}

// Repetição espaçada (Leitner, caixas 1–5) dos exercícios que o aluno errou
model RevisaoItem {
  id           Int       @id @default(autoincrement())
  usuarioId    Int
  exercicioId  Int
  caixa        Int       @default(1)
  proximaEm    DateTime
  acertos      Int       @default(0)
  erros        Int       @default(0)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  exercicio    Exercicio @relation(fields: [exercicioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, exercicioId])
  @@index([usuarioId, proximaEm])
  @@index([exercicioId])
}

model TentativaTeste {
  id            Int       @id @default(autoincrement())
  usuarioId     Int
  moduloId      Int
  forma         Int
  itemIds       Json // number[] na ordem apresentada
  respostas     Json?
  percentual    Int?
  porHabilidade Json? // { [habilidade]: percentual }
  aprovado      Boolean?
  iniciadaEm    DateTime  @default(now())
  finalizadaEm  DateTime?
  usuario       Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  modulo        Modulo    @relation(fields: [moduloId], references: [id], onDelete: Cascade)

  @@index([usuarioId, moduloId])
  @@index([moduloId])
}
