# Banco (PostgreSQL do docker compose)
POSTGRES_DB=sweetway
POSTGRES_USER=sweetway
# Obrigatório. Gere uma senha forte; evite @ : / ? # (ou use URL encoding em DATABASE_URL)
POSTGRES_PASSWORD=
# Opcional: por padrão o compose monta postgresql://POSTGRES_USER:POSTGRES_PASSWORD@postgres:5432/POSTGRES_DB
# DATABASE_URL=

# Backend
# Obrigatório, mínimo 16 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
APP_URL=http://localhost:3333
# Origens permitidas no CORS (separadas por vírgula). O navegador fala com a API pela mesma origem (/api), então
# isto só vale para quem chama a porta 3333 direto de outra origem.
CORS_ORIGIN=http://localhost:3000
# Endereço público do frontend (link do e-mail de nova senha)
FRONTEND_URL=http://localhost:3000
# E-mail (Resend). Sem a chave nenhum e-mail sai; fora de produção o link de nova senha aparece no log do backend
# (em produção, não: quem lesse o log poderia trocar a senha de outra pessoa).
RESEND_API_KEY=
EMAIL_FROM=Sweet Way English <onboarding@resend.dev>
# Cookie de sessão com Secure: sempre ligado com NODE_ENV=production (padrão do compose). Atrás de HTTPS ele é obrigatório.
COOKIE_SECURE=
# Logs JSON do backend: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Seed: só roda quando SEED_ON_START=1 (use na primeira subida e depois volte para 0)
SEED_ON_START=0
# Contas e turmas de demonstração (senha123). Nunca em produção.
SEED_DEMO=
# Admin inicial criado pelo seed
ADMIN_EMAIL=
ADMIN_SENHA=
# 1 = importa o curso já publicado (demo/e2e); vazio = fica em revisão para a professora
SEED_PUBLICAR_CONTEUDO=

# Frontend: nada a configurar. O navegador chama /api na mesma origem e o Next repassa ao serviço "backend"
# (BACKEND_URL=http://backend:3333, fixado no docker-compose.yml). NEXT_PUBLIC_API_URL não é mais usado.
