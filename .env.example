# Backend
# Obrigatório, mínimo 16 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
APP_URL=http://localhost:3333
# Origens do frontend permitidas no CORS (separadas por vírgula)
CORS_ORIGIN=http://localhost:3000
# Primeiro admin, criado no primeiro start se ainda não houver nenhum (senha com 12+ caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 1 = carrega os dados de demonstração (contas com senha "senha123"). Só para uso local!
SEED_DEMO=0

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3333
